# Copy to .env. Relative paths resolve from the project working directory.
DUSTMAPS_DATABASE_URL=sqlite:///./var/dustmaps.db
# Existing database example (keep credentials only in .env):
# DUSTMAPS_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dustmaps
DUSTMAPS_OUTPUT_DIR=var/results
DUSTMAPS_PUBLIC_BASE_URL=
DUSTMAPS_BCP_ARTICLE_IDS=["demo-bcp"]
DUSTMAPS_CORS_ORIGINS=["http://localhost:5173"]
DUSTMAPS_DUST_DATA_PATH=
DUSTMAPS_DUST_3D_PATH=
DUSTMAPS_DUSTMAPS_FITS_PATH=
DUSTMAPS_SUPERBUBBLE_PATH=
DUSTMAPS_FONT_PATH=
DUSTMAPS_VIEWER_DIR=
DUSTMAPS_CMS_FILES_DIR=
DUSTMAPS_COMPUTE_WORKERS=1
DUSTMAPS_MAX_PENDING_COMPUTATIONS=4
DUSTMAPS_COMPUTE_TIMEOUT_SECONDS=300
DUSTMAPS_MAX_UPLOAD_MB=20
DUSTMAPS_MAX_BATCH_ROWS=100000
DUSTMAPS_STILTS_COMMAND=stilts
